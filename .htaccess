# ============================================================
# TIKUM INSOM — .htaccess (REVISI)
# ============================================================

Options -MultiViews
RewriteEngine On

# --- 1. Serve file .html kalau URL tanpa ekstensi ---
# Contoh: /home -> home.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# --- 2. Kalau /home.html diakses langsung, redirect ke /home (301) ---
# TAPI jangan redirect kalau request-nya dari internal rewrite
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/index\.html$
RewriteRule ^ /%1 [R=301,L,NE]

# --- 3. Fallback terakhir: kalau nggak ketemu, arahkan ke index.html ---
# Ini mencegah 404 mentah dari server
ErrorDocument 404 /index.html

# --- 4. Caching & kompresi (opsional, aman) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>